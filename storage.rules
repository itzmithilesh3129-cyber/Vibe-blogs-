rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Featured & inline article images: free-tier friendly max 1.5 MB JPEG/PNG/WebP
    match /uploads/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1572864
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}
